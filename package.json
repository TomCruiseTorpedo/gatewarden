{
  "name": "gatewarden",
  "version": "0.0.0",
  "private": true,
  "description": "MCP Gateway \u2014 one in-path proxy that scores a downstream MCP server's agent-usability and governs every tool call with capability leases. Fuses mcp-fit (score) and leasebroker (govern).",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:score": "bun run --filter '@gatewarden/score' test",
    "test:govern": "bun run --filter '@gatewarden/govern' test",
    "demo": "bun run --filter '@gatewarden/gateway' demo",
    "check:workspace-pins": "bash scripts/check-workspace-pins.sh"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "body-parser": "^2.3.0",
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.15",
    "ip-address": "^10.7.1",
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "brace-expansion": "^5.0.12"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
