{
  "name": "@gatewarden/score",
  "version": "0.1.0",
  "description": "MCP server agent-usability scorer — scores and auto-fixes tool descriptions (vendored from mcp-fit, run #1)",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/**/*.js",
    "!src/**/*.d.ts",
    "!src/**/*.map",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:score-sync": "bash scripts/check-sync.sh",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "canonicalize": "^3",
    "jose": "^6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCruiseTorpedo/gatewarden.git",
    "directory": "packages/score"
  },
  "bugs": {
    "url": "https://github.com/TomCruiseTorpedo/gatewarden/issues"
  },
  "homepage": "https://github.com/TomCruiseTorpedo/gatewarden#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "llm",
    "scorecard",
    "agent-usability",
    "linter"
  ]
}
