{
  "name": "@gatewarden/gateway",
  "version": "0.1.0",
  "description": "MCP Gateway \u2014 one in-path proxy that scores a downstream MCP server and governs every tool call with capability leases. Fuses @gatewarden/score and @gatewarden/govern.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gatewarden": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "bun ./scripts/demo.mjs"
  },
  "dependencies": {
    "@gatewarden/govern": "workspace:*",
    "@gatewarden/score": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCruiseTorpedo/gatewarden.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/TomCruiseTorpedo/gatewarden/issues"
  },
  "homepage": "https://github.com/TomCruiseTorpedo/gatewarden#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "gateway",
    "proxy",
    "security",
    "least-privilege",
    "capability"
  ]
}
