{
  "name": "@gatewarden/govern",
  "version": "0.1.0",
  "description": "Local-first capability-lease broker + in-path MCP enforcement proxy (vendored from leasebroker, run #2).",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!src/**/*.js",
    "!src/**/*.d.ts",
    "!src/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "bun ./scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ed25519": "^3.1.0",
    "minimatch": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCruiseTorpedo/gatewarden.git",
    "directory": "packages/govern"
  },
  "bugs": {
    "url": "https://github.com/TomCruiseTorpedo/gatewarden/issues"
  },
  "homepage": "https://github.com/TomCruiseTorpedo/gatewarden#readme",
  "keywords": [
    "mcp",
    "agent",
    "capability",
    "least-privilege",
    "lease",
    "authorization",
    "security"
  ]
}
